@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.AI
@using Microsoft.EntityFrameworkCore
@using RoomBooking.Agent
@using RoomBooking.Core.Data
@using RoomBooking.Core.Domain
@using RoomBooking.Web.Auth
@inject BookingAssistant Assistant
@inject IDbContextFactory<BookingDbContext> Database
@inject CurrentUser CurrentUser
@inject AuthenticationStateProvider AuthState

<PageTitle>Meeting rooms</PageTitle>

@* Materialised once: the projection is read twice below, and the composer re-renders the page on
   every keystroke, so leaving it lazy rebuilds every entry twice per character typed. *@
@{
    var rendered = Rendered();
}

<div class="chat">
    <header>
        <div>
            <strong>Meeting rooms</strong>
            <span class="muted">Cubo Itaú</span>
        </div>
        <div class="who">
            <span>@CurrentUser.Username</span>
            <form action="/logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="link">Sign out</button>
            </form>
        </div>
    </header>

    <div class="transcript">
        @if (rendered.Count == 0)
        {
            @* Written here rather than generated. The rules below are facts, not something worth
               asking a model to compose: this way the greeting is instant, costs nothing against
               the daily allowance, and still appears on a day when that allowance is spent — which
               is precisely when a blank window would be most misleading. *@
            <div class="bubble theirs greeting">
                <p>
                    Hello. I look after the meeting rooms at the Cubo Itaú office — I can check what
                    is free, book a room for you, and cancel a booking you have made.
                </p>
                <p>There are five rooms, and they are not the same size:</p>
                <ul class="rooms">
                    @foreach (var room in Rooms)
                    {
                        <li><strong>@room.Id</strong> <span class="muted">up to @room.Capacity</span></li>
                    }
                </ul>
                <p>
                    Rooms go in 30-minute slots, on the hour or the half hour, for up to 3 hours at a
                    time. Every booking needs a title and the number of people coming.
                </p>
                <p class="muted">
                    Try &ldquo;which rooms are free tomorrow between 10 and 11 for six people?&rdquo;
                    &mdash; or just say what you need. I answer in whichever language you write in.
                </p>
            </div>
        }

        @foreach (var entry in rendered)
        {
            @if (entry.Tools.Length > 0)
            {
                @* Folded away by default. Which tools ran is the evidence that the assistant read
                   the calendar rather than recalled it, so it stays available — but it is a claim
                   about the machinery, not part of the answer, and it does not belong in the way. *@
                <details class="trace">
                    <summary>@ToolCallSummary(entry.Tools.Length)</summary>
                    <div class="tools">
                        @foreach (var tool in entry.Tools)
                        {
                            <span class="tool">@tool</span>
                        }
                    </div>
                </details>
            }

            @if (!string.IsNullOrWhiteSpace(entry.Text))
            {
                <div class="bubble @(entry.IsUser ? "mine" : "theirs")">
                    @if (entry.IsUser)
                    {
                        @entry.Text
                    }
                    else
                    {
                        @MarkdownRenderer.ToHtml(entry.Text)
                    }
                </div>
            }
        }

        @if (busy)
        {
            <div class="bubble theirs pending" role="status" aria-label="The assistant is thinking">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            </div>
        }
    </div>

    @* preventDefault matters: without it the browser posts the form natively, the page reloads
       and the circuit — along with the conversation — is thrown away. *@
    <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
        <input @bind="draft" @bind:event="oninput" placeholder="Ask about rooms, or book one"
               disabled="@busy" />
        <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(draft))">Send</button>
    </form>

    @if (failure is not null)
    {
        <p class="error" role="alert">@failure</p>
    }

    <Attribution />
</div>

@code {
    private readonly List<ChatMessage> history = [];
    private string draft = string.Empty;
    private bool busy;
    private string? failure;

    private sealed record Entry(bool IsUser, string Text, string[] Tools);

    private static string ToolCallSummary(int count) => count == 1 ? "1 tool call" : $"{count} tool calls";

    /// <summary>
    /// Flattens the conversation for display, surfacing which tools ran. Showing the tool names is
    /// deliberate: it is the difference between the assistant reporting the calendar and appearing
    /// to know it.
    /// </summary>
    private List<Entry> Rendered() => history
        .Where(m => m.Role != ChatRole.System && m.Role != ChatRole.Tool)
        .Select(m => new Entry(
            m.Role == ChatRole.User,
            m.Text ?? string.Empty,
            m.Contents.OfType<FunctionCallContent>().Select(c => ToolLabel.Display(c.Name)).ToArray()))
        .Where(e => !string.IsNullOrWhiteSpace(e.Text) || e.Tools.Length > 0)
        .ToList();

    private IReadOnlyList<Room> Rooms = [];

    protected override async Task OnInitializedAsync()
    {
        // Read rather than hard-coded: the greeting states the capacities, and a greeting that
        // disagrees with what the tools enforce is worse than none.
        await using var db = await Database.CreateDbContextAsync();
        Rooms = await db.Rooms.OrderBy(r => r.Id).ToListAsync();

        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;

        CurrentUser.Set(
            user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value,
            user.Identity?.Name ?? "User");
    }

    private async Task SendAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(draft))
            return;

        var message = draft.Trim();
        draft = string.Empty;
        failure = null;
        busy = true;

        history.Add(new ChatMessage(ChatRole.User, message));

        try
        {
            await Assistant.ContinueAsync(history, CurrentUser.Username);
        }
        catch (AssistantUnavailableException ex)
        {
            // Already phrased for a reader; the provider's own wording is about token budgets.
            failure = ex.Message;
        }
        catch (Exception ex)
        {
            failure = $"The assistant could not be reached: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
